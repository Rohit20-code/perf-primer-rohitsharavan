  "item": [
    {
      "name": "1. GET all posts",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"status is 200\", () => pm.response.to.have.status(200));",
              "pm.test(\"returns 100 posts\", () => pm.expect(pm.response.json()).to.have.lengthOf(100));"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/posts",
          "host": ["{{baseUrl}}"],
          "path": ["posts"]
        }
      },
      "response": []
    },
    {
      "name": "2. GET post 1",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"status is 200\", () => pm.response.to.have.status(200));",
              "pm.test(\"is post 1\", () => pm.expect(pm.response.json().id).to.eql(1));",
              "",
              "// Deliberate failure from the exercise (uncomment to see a FAIL):",
              "// pm.test(\"status is 201\", () => pm.response.to.have.status(201));"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/posts/1",
          "host": ["{{baseUrl}}"],
          "path": ["posts", "1"]
        }
      },
      "response": []
    },
    {
      "name": "3. GET posts by userId=1",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"status is 200\", () => pm.response.to.have.status(200));",
              "pm.test(\"every post belongs to user 1\", () => {",
              "    pm.response.json().forEach(p => pm.expect(p.userId).to.eql(1));",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/posts?userId=1",
          "host": ["{{baseUrl}}"],
          "path": ["posts"],
          "query": [{ "key": "userId", "value": "1" }]
        }
      },
      "response": []
    },
    {
      "name": "4. POST create post",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"status is 201\", () => pm.response.to.have.status(201));",
              "pm.test(\"new id returned\", () => pm.expect(pm.response.json().id).to.eql(101));"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json; charset=UTF-8" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"title\": \"perf primer\",\n  \"body\": \"my first POST\",\n  \"userId\": 1\n}",
          "options": { "raw": { "language": "json" } }
        },
        "url": {
          "raw": "{{baseUrl}}/posts",
          "host": ["{{baseUrl}}"],
          "path": ["posts"]
        }
      },
      "response": []
    },
    {
      "name": "5. PUT update post 1",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"status is 200\", () => pm.response.to.have.status(200));",
              "pm.test(\"title updated\", () => pm.expect(pm.response.json().title).to.eql(\"updated title\"));"
            ]
          }
        }
      ],
      "request": {
        "method": "PUT",
        "header": [{ "key": "Content-Type", "value": "application/json; charset=UTF-8" }],
        "body": {
